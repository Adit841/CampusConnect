# ==============================================================================
# CampusConnect Frontend - Environment Configuration Template
# Copy to .env.local for local overrides.
# In deployment (e.g., Vercel / Netlify), configure these in your project dashboard.
# ==============================================================================

# REST API Base URL
# Local development default:
VITE_API_BASE_URL=http://localhost:8080/api

# Deployed Shared Backend Example:
# Point ALL team members and teacher to this single deployed backend URL:
# VITE_API_BASE_URL=https://campusconnect-api.onrender.com/api

# Real-time WebSocket Endpoint (SockJS)
# Local development default:
VITE_WS_BASE_URL=http://localhost:8080/ws/sockjs

# Deployed Shared Backend Example:
# VITE_WS_BASE_URL=https://campusconnect-api.onrender.com/ws/sockjs
