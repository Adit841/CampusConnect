
# ==============================================================================
# CampusConnect Backend - Environment Configuration Template
# Copy to .env for local development.
# NEVER commit real credentials or production secrets to GitHub.
# ==============================================================================

# Server
SERVER_PORT=8080

# Spring Profile
# Uncomment for hosted deployment after configuring production variables.
# SPRING_PROFILES_ACTIVE=prod

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# Option 1: Local MySQL (default)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campusconnect?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Option 2: Shared Aiven MySQL
# For Aiven, replace the values below with your actual connection details.
# Uncomment these lines and comment out the local settings above.
#
# SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_AIVEN_HOST:19200/defaultdb?sslMode=REQUIRED
# SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USERNAME
# SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

# ==============================================================================
# HIKARICP CONNECTION POOL
# ==============================================================================

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

# ==============================================================================
# JPA / HIBERNATE
# ==============================================================================

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ==============================================================================
# CORS
# Add your deployed frontend URL when deploying.
# Separate multiple origins with commas.
# ==============================================================================

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Example for deployment:
# CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN

# ==============================================================================
# JWT AUTHENTICATION
# Generate a unique random secret for your local environment.
# Configure a separate secret in your deployment environment.
# ==============================================================================

JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_EXPIRATION_MS=86400000

# ==============================================================================
# ADMIN PROVISIONING (optional)
# On startup, the account with this email is promoted to ADMIN.
# The password is only used to create the account if it does not exist yet;
# an existing account's password is never changed.
# ==============================================================================

# ADMIN_PROVISION_EMAIL=
# ADMIN_PROVISION_PASSWORD=

# ==============================================================================
# CHAT
# ==============================================================================

CHAT_MESSAGE_MAX_LENGTH=4000

# ==============================================================================
# ACADEMICS FILE STORAGE
# Assignment attachments and submission files are stored on local disk.
# Relative paths resolve against the backend's working directory; use a
# persistent volume path in production. Never point this at a public web root.
# ==============================================================================

ACADEMICS_STORAGE_DIR=uploads/academics
ACADEMICS_MAX_FILE_MB=10
ACADEMICS_MAX_REQUEST_MB=12
# ACADEMICS_ALLOWED_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,txt,md,csv,zip,png,jpg,jpeg
