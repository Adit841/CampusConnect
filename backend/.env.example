# Copy the values you need into your shell or IDE run configuration.
# Never commit real credentials.
DB_URL=jdbc:mysql://localhost:3306/campusconnect
DB_USERNAME=
DB_PASSWORD=
SERVER_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=your_base64_or_hex_encoded_secret_key_must_be_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000

# Chat module (ayushman-feature)
CHAT_MESSAGE_MAX_LENGTH=4000
